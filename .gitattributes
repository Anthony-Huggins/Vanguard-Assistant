# Normalize line endings on commit so the repo stays cross-platform.
# Shell scripts and Python files must have LF in the Linux containers.

* text=auto

# Force LF for files that run inside Linux containers
*.sh      text eol=lf
*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.ini     text eol=lf
*.conf    text eol=lf
*.sql     text eol=lf
Dockerfile* text eol=lf

# Binaries — no line-ending conversion
*.sqlite  binary
*.sqlite3 binary
*.png     binary
*.jpg     binary
*.pdf     binary

# ----- LLM provider -----
# Options: azure_openai | openai | anthropic
LLM_PROVIDER=azure_openai
# Class deployments available: gpt-4.1-nano | gpt-4.1
LLM_MODEL=gpt-4.1-nano
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS_COORDINATOR=1024
LLM_MAX_TOKENS_SUBAGENT=2048

# ----- Azure OpenAI -----
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Must be one of: gpt-4.1-nano | gpt-4.1
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
# Leave AZURE_OPENAI_API_KEY blank to fall back to DefaultAzureCredential
AZURE_OPENAI_API_KEY=

# ----- Embeddings -----
# Options: huggingface | openai | azure_openai
EMBEDDER_PROVIDER=huggingface
EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ----- Vector store -----
# Options: chroma | pinecone
VECTORSTORE_BACKEND=chroma
# ``embedded`` (default) — Chroma runs in-process via persist_directory.
# ``http``     — talk to a Chroma service container at CHROMA_URL (M10).
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=vanguard_kb
# Used only when CHROMA_MODE=http (the docker-compose stack sets this).
CHROMA_URL=http://localhost:8000

# Pinecone (only used if VECTORSTORE_BACKEND=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=

# ----- RAG knobs -----
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
# Calibrated for sentence-transformers/all-MiniLM-L6-v2 on the Vanguard corpus.
# Real-question best-score range: 0.35-0.61. Off-topic noise: -0.12 to -0.04.
# Re-tune if you swap embedders.
RAG_SIMILARITY_THRESHOLD=0.25

# ----- Conversation -----
HISTORY_MAX_TURNS=20

# ----- Research tool data -----
# Path to the SQLite warehouse the local db_query tool reads from.
WAREHOUSE_DB_PATH=./data/fund_warehouse.sqlite

# ----- MCP server (action tools only — research tools are in-process) -----
MCP_URL=http://localhost:8765/mcp
MCP_BEARER_TOKEN=dev-token-change-me

# ----- SendGrid (used by the send_email action tool) -----
# Leave blank to fall back to the local stub (logs to console + JSONL).
# The from-email MUST be a verified sender in your SendGrid account.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ----- Jira (used by the create_ticket action tool) -----
# Leave blank to fall back to the local stub.
# Generate JIRA_API_TOKEN at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=VG

# ----- API server (M6 — apps/api) -----
# Comma-separated origins allowed by CORS (Vite dev server by default).
API_CORS_ORIGINS=http://localhost:5173

# ----- Checkpointer (M9) -----
# ``sqlite`` (default) or ``postgres``. Postgres requires POSTGRES_DSN.
CHECKPOINTER_BACKEND=sqlite
# Where AsyncSqliteSaver stores its database when CHECKPOINTER_BACKEND=sqlite.
# Shared with the CLI by default so a thread_id created in one is visible
# in the other.
CHECKPOINT_SQLITE_PATH=.checkpoints.sqlite
# Used when CHECKPOINTER_BACKEND=postgres. Plain psycopg-style DSN.
# Bring up the DB via: docker compose -f infra/docker-compose.dev.yml up -d
POSTGRES_DSN=

# ----- App database (M9) -----
# SQLAlchemy AsyncEngine DSN for the API's metadata tables. Defaults to a
# local SQLite file. For Postgres use ``postgresql+asyncpg://...``.
# Run ``./.venv/Scripts/python.exe -m alembic upgrade head`` after changing.
APP_DB_DSN=sqlite+aiosqlite:///.app_db.sqlite

# ----- Misc -----
LOG_LEVEL=INFO

# ----- Ragas eval (M12) -----
# gpt-4.1 (full) for Ragas judge scoring; nano is too weak for judge prompts.
EVAL_JUDGE_MODEL=gpt-4.1
EVAL_DATA_PATH=packages/eval/datasets/qa_pairs.jsonl
EVAL_RESULTS_DIR=packages/eval/results

# ----- LangSmith (Phase C) -----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vanguard-assistant
